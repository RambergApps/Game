+// DPR-bevisst canvas: bakbuffer = CSS-størrelse × DPR (maks 2). canvas.width/height, ctx.setTransform/resetTransform/getTransform
+// ses i CSS-px, så kamera, input (mus → verden), HUD og modulenes setTransform(1,0,0,1,…) stemmer uendret. DPR leses på nytt ved resize.
+let DPR = 1, LW = innerWidth, LH = innerHeight;
