+  Object.defineProperty(canvas, 'height', { configurable: true, get: () => LH, set: (v) => { LH = v; HD.set.call(canvas, Math.round(v * DPR)); } });
+  const st = ctx.setTransform.bind(ctx), gt = ctx.getTransform.bind(ctx);
+  ctx.setTransform = (a, b, c, d, e, f) => {
+    if (a === undefined) { a = d = 1; b = c = e = f = 0; } else if (typeof a === 'object') ({ a, b, c, d, e, f } = DOMMatrix.fromMatrix(a));
+    return st(a * DPR, b * DPR, c * DPR, d * DPR, e * DPR, f * DPR);
+  };
+  ctx.resetTransform = () => ctx.setTransform(1, 0, 0, 1, 0, 0);
+  ctx.getTransform = () => { const m = gt(); return new DOMMatrix([m.a / DPR, m.b / DPR, m.c / DPR, m.d / DPR, m.e / DPR, m.f / DPR]); };
+}
+function resize() {
+  DPR = Math.min(2, devicePixelRatio || 1);
